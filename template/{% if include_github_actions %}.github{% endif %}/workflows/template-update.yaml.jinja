name: Update from template

on:
  workflow_dispatch:
    inputs:
      version:
        description: 'Template version (leave empty for latest)'
        required: false
        default: ''

permissions:
  contents: write
  pull-requests: write

jobs:
  update:
    runs-on: ubuntu-latest
    env:
      PY_VERSION: "{{ python_version }}"
    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          version-file: uv.toml
          python-version: "{{ python_version }}"

      - name: Update from template
        env:
          TEMPLATE_REF: {% raw %}${{ inputs.version }}{% endraw %}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          args=(update --trust --defaults)
          if [ -n "$TEMPLATE_REF" ]; then
            args+=(--vcs-ref="$TEMPLATE_REF")
          fi
          uv tool run --from copier==9.19.1 copier "${args[@]}"
          git diff --check
          if [ -n "$(git ls-files --others --exclude-standard '*.rej')" ]; then
            echo "Copier left conflicts; resolve the update locally."
            exit 1
          fi

      # The template update may require a newer uv and different dependencies.
      - name: Install the updated uv version
        uses: astral-sh/setup-uv@v7
        with:
          version-file: uv.toml
          python-version: "{{ python_version }}"

      - name: Refresh the project lockfile
        run: uv lock

      # GITHUB_TOKEN-created PRs do not trigger the ordinary PR workflow.
      - name: Validate updated project before opening its PR
        uses: ./.github/actions/validation

      - name: Create pull request
        uses: peter-evans/create-pull-request@v8
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          commit-message: "chore: update from project template"
          title: "chore: update from project template"
          body: |
            Updates the project template and refreshes uv.lock.

            Formatting, lint, types, and tests passed before this PR was opened.
            Validation run: {% raw %}${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}{% endraw %}

            PR workflows are not automatically triggered by GITHUB_TOKEN.
            Review conflicts and application-specific changes before merging.
          branch: chore/template-update
          delete-branch: true
          labels: |
            dependencies
            template
