[tool.poe.tasks.sync]
help = "Install the committed dependency versions."
cmd = "uv sync --locked"

[tool.poe.tasks.install-hooks]
help = "Install prek hooks."
cmd = "uv run --locked prek install"

[tool.poe.tasks.setup]
help = "Sync dependencies and install hooks."
sequence = ["sync", "install-hooks"]

[tool.poe.tasks.format]
help = "Format code."
cmd = "uv run --locked ruff format ."

[tool.poe.tasks.lint]
help = "Lint and fix code."
cmd = "uv run --locked ruff check --fix ."

[tool.poe.tasks.format-check]
help = "Check formatting without changing files."
cmd = "uv run --locked ruff format --check ."

[tool.poe.tasks.lint-check]
help = "Check lint without changing files."
cmd = "uv run --locked ruff check --no-fix ."

[tool.poe.tasks.check]
help = "Check types in source and tests."
cmd = "uv run --locked mypy src tests{% if include_postgres %} migrations{% endif %}"

[tool.poe.tasks.test]
help = "Run tests."
cmd = "uv run --locked pytest"

[tool.poe.tasks.flc]
help = "Fix lint, format, and check types."
sequence = ["lint", "format", "check"]

[tool.poe.tasks.flct]
help = "Fix lint, format, check types, and test."
sequence = ["flc", "test"]

[tool.poe.tasks.validate]
help = "Validate without modifying source or the lockfile."
sequence = ["lint-check", "format-check", "check", "test-cov"]

[tool.poe.tasks.test-cov]
help = "Run tests with branch coverage."
cmd = "uv run --locked pytest --cov --cov-report=term-missing --cov-report=xml --no-cov-on-fail"
{% if include_docker %}
[tool.poe.tasks.dockerize]
help = "Build the Docker image using the committed lockfile."
cmd = "docker build -t {{ project_slug }} ."
{% endif %}
{% if include_postgres %}
[tool.poe.tasks."db:up"]
help = "Start local PostgreSQL and wait until healthy."
cmd = "docker compose --env-file .env -f compose.db.yaml up --wait --wait-timeout 60"

[tool.poe.tasks."db:down"]
help = "Stop and remove local PostgreSQL, preserving its data."
cmd = "docker compose --env-file .env -f compose.db.yaml down"

[tool.poe.tasks."db:destroy"]
help = "Remove local PostgreSQL and permanently delete its data volume."
cmd = "docker compose --env-file .env -f compose.db.yaml down --volumes"

[tool.poe.tasks."db:setup"]
help = "Apply all migrations to the configured database."
cmd = "uv run --locked --env-file .env alembic upgrade head"
{% endif %}
